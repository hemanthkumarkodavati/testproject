    LessonEntity lessonEntity = new LessonEntity();
    lessonEntity.setContent(lessonRequestDto.getContent());
    lessonEntity.setDuration(lessonRequestDto.getDuration());
    lessonEntity.setTitle(lessonRequestDto.getTitle());

    return  lessonEntity;
